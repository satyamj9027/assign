## Mini production code

```python
# idempotent_payment_tool.py
import hashlib
import time
from dataclasses import dataclass

LEDGER = {}          # idempotency_key -> txn
LOCKS = {}           # simple in-memory lock


def stable_key(user_id: str, intent_id: str, amount: int, to: str) -> str:
    raw = f"{user_id}|{intent_id}|{amount}|{to}"
    return hashlib.sha256(raw.encode()).hexdigest()


@dataclass
class Txn:
    txn_id: str
    status: str
    amount: int
    attempts: int


def create_payment(user_id: str, intent_id: str, amount: int, to: str) -> dict:
    """Write tool: never create a second debit for the same intent."""
    key = stable_key(user_id, intent_id, amount, to)

    if key in LEDGER:
        t = LEDGER[key]
        return {
            "ok": True,
            "existing": True,          # retry hit
            "txn_id": t.txn_id,
            "status": t.status,
            "attempts": t.attempts,
        }

    # simulate: backend commits, then client times out on first call
    t = Txn(txn_id=f"txn_{len(LEDGER)+1}", status="SUCCEEDED", amount=amount, attempts=1)
    LEDGER[key] = t
    return {"ok": True, "existing": False, "txn_id": t.txn_id, "status": t.status}


def agent_safe_write(user_id: str, intent_id: str, amount: int, to: str) -> dict:
    """On timeout: LOOKUP / same key. Do not mint a new intent_id."""
    last_error = None
    for attempt in range(1, 4):
        try:
            # attempt 1: pretend timeout AFTER server commit
            result = create_payment(user_id, intent_id, amount, to)
            if attempt == 1 and not result["existing"]:
                raise TimeoutError("MCP response lost after commit")
            return result
        except TimeoutError as e:
            last_error = str(e)
            time.sleep(0.05)  # jitter in real system
            # next loop uses SAME intent_id
    return {"ok": False, "error": last_error}


# --- first user click ---
r1 = agent_safe_write("u1", "intent_9", 500, "merchant_x")
# --- agent retries because UI showed failed ---
r2 = create_payment("u1", "intent_9", 500, "merchant_x")

print("after_retry", r2)
print("ledger_size", len(LEDGER))

#output
# TimeoutError on first client view (not printed)
# after_retry {'ok': True, 'existing': True, 'txn_id': 'txn_1', 'status': 'SUCCEEDED', 'attempts': 1}
# ledger_size 1
```

