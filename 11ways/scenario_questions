## Mini code (poll + webhook + no second debit)

```python
# confirm_payment.py
import hashlib
from typing import Literal

Store = {}           # intent_id -> record
SeenEvents = set()   # webhook event_id


def start_pay(user: str, intent: str, amount: int) -> dict:
    rec = Store.get(intent)
    if rec:
        return {"existing": True, **rec}
    rec = {
        "user": user,
        "amount": amount,
        "status": "PENDING",
        "txn_id": f"txn_{intent}",
    }
    Store[intent] = rec
    # backend "commits" quickly
    rec["status"] = "SUCCEEDED"
    return {"existing": False, **rec}


def get_pay(intent: str) -> dict:
    rec = Store.get(intent)
    if not rec:
        return {"status": "NOT_FOUND"}
    return rec


def webhook_pay(event_id: str, intent: str, status: str) -> dict:
    if event_id in SeenEvents:
        return {"ok": True, "duplicate_event": True}
    SeenEvents.add(event_id)
    rec = Store.setdefault(intent, {"status": "PENDING", "txn_id": f"txn_{intent}"})
    rec["status"] = status
    return {"ok": True, "duplicate_event": False, "status": rec["status"]}


def agent_after_timeout(intent: str) -> dict:
    # NEVER start_pay again first
    s = get_pay(intent)
    if s.get("status") == "SUCCEEDED":
        return {"action": "SHOW_RECEIPT", "txn_id": s["txn_id"]}
    if s.get("status") == "PENDING":
        return {"action": "WAIT_OR_POLL"}
    if s.get("status") == "NOT_FOUND":
        return {"action": "SAFE_TO_START_SAME_KEY"}
    return {"action": "STOP", "status": s}


# simulate: start committed, client timed out, then poll + double webhook
start_pay("u1", "intent_9", 500)
print(agent_after_timeout("intent_9"))
print(webhook_pay("evt_1", "intent_9", "SUCCEEDED"))
print(webhook_pay("evt_1", "intent_9", "SUCCEEDED"))  # provider retry
print("intents", len(Store), "events", len(SeenEvents))

#output
# {'action': 'SHOW_RECEIPT', 'txn_id': 'txn_intent_9'}
# {'ok': True, 'duplicate_event': False, 'status': 'SUCCEEDED'}
# {'ok': True, 'duplicate_event': True}
# intents 1 events 1
```

